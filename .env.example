# Шаблон env-переменных для прогона UI-тестов с интеграцией Test IT.
# Скопируйте в .env (он в .gitignore) и подставьте реальные значения.

# --- Стенд приложения ---
HEADLESS=true
LOGIN_URL=https://localhost:8001/user/login
TEST_USER_LOGIN=Admin
TEST_USER_PASSWORD=123

# --- Деструктивные сценарии (по умолчанию выключены) ---
RUN_DESTRUCTIVE_DEVICES_CRUD=false
RUN_DESTRUCTIVE_PERSONNEL_CRUD=false
RUN_DESTRUCTIVE_PRODUCTION_UNITS_CRUD=false

# --- Test IT (self-hosted, zyfra) ---
TMS_URL=https://testit.zyfra.com
TMS_PRIVATE_TOKEN=REPLACE_ME
# Проект MDC (globalId 3117). Если нужно лить в другой проект - замени GUID.
TMS_PROJECT_ID=4974a48f-041b-44ac-a42e-ebab5bb3a74b
# configurationId узнается одной командой - см. README раздел "Test IT".
TMS_CONFIGURATION_ID=
# Оставить пустым, чтобы адаптер сам создал TestRun
TMS_TEST_RUN_ID=
